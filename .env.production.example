NODE_ENV="production"
PORT=3333

# Neon:
# Use a URL com pooler em DATABASE_URL para a API.
# Use a URL direta em DIRECT_URL para migrations.
DATABASE_URL="postgresql://usuario:senha@host-pooler.neon.tech/banco?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@host.neon.tech/banco?sslmode=require"

JWT_SECRET="substitua-por-uma-chave-secreta-forte-com-32-caracteres-ou-mais"
CORS_ORIGIN="https://app.seudominio.com.br"
GOOGLE_CLIENT_ID=""

NFSE_CERTIFICADO_CRYPTO_KEY=""
NFSE_XSD_DPS_PATH="/app/schemas/DPS_v1.01.xsd"
NFSE_XSD_EVENTO_PATH="/app/schemas/pedRegEvento_v1.01.xsd"
NFSE_SEFIN_HOMOLOGACAO_BASE_URL="https://sefin.producaorestrita.nfse.gov.br/SefinNacional"
NFSE_SEFIN_PRODUCAO_BASE_URL="https://sefin.nfse.gov.br/SefinNacional"
NFSE_SEFIN_BASE_URL=""
NFSE_SEFIN_ENVIO_DPS_PATH="/nfse"
NFSE_SEFIN_TIMEOUT_MS=15000
NFSE_ADN_HOMOLOGACAO_BASE_URL="https://adn.producaorestrita.nfse.gov.br/contribuintes"
NFSE_ADN_PRODUCAO_BASE_URL="https://adn.nfse.gov.br/contribuintes"
NFSE_ADN_TIMEOUT_MS=15000

# Comece false. Mude para true so depois da revisao fiscal e teste controlado.
NFSE_PERMITIR_PRODUCAO_REAL="false"
